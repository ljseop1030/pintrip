rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------

    // 로그인된 사용자 확인
    function isSignedIn() {
      return request.auth != null;
    }

    // 대상 방(roomId)의 memberIds에 로그인한 사용자가 포함되어 있는지 확인
    function isRoomMember(roomId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    // -------------------------------------------------------------
    // 0. 사용자 프로필 컬렉션 규칙 (users/{uid})
    // -------------------------------------------------------------
    match /users/{uid} {
      // 읽기: 로그인한 사용자는 프로필 조회 가능
      allow read: if isSignedIn();

      // 생성 (create): 본인 UID 문서만 허용 + 실제 인증 계정 이메일 일치 + #RRGGBB 규격 + 서버 생성 시각
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.avatarColor is string
        && request.resource.data.avatarColor.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'avatarColor', 'createdAt']);

      // 수정 (update): 본인 UID 문서만 허용 + 실제 인증 계정 이메일 일치 + 기존 createdAt 보존 + 필드 규격 검증
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.avatarColor is string
        && request.resource.data.avatarColor.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['nickname', 'email', 'avatarColor', 'createdAt']);
    }

    // -------------------------------------------------------------
    // 1. 초대 코드 컬렉션 규칙 (inviteCodes/{code})
    // -------------------------------------------------------------
    match /inviteCodes/{code} {
      // 읽기 (get): 로그인한 사용자는 초대 코드 존재 여부 단건 조회 가능 (코드 충돌 검사용)
      allow get: if isSignedIn();

      // 목록 조회, 수정, 삭제 차단
      allow list, update, delete: if false;

      // 생성 (create): 로그인 유저 + 신규 생성 + 방 생성과 원자적 연결 검증
      allow create: if isSignedIn()
        // 생성 전 부재 검증: inviteCodes/{code} 및 대상 rooms/{roomId} 문서 모두 미존재
        && !exists(/databases/$(database)/documents/inviteCodes/$(code))
        && !exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        // 필드 규격 검증
        && request.resource.data.keys().hasOnly(['roomId', 'createdAt'])
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.createdAt == request.time
        // 동일 원자적 요청에서 생성되는 rooms 문서와의 상호 연결 및 생성자 소유 검증 (getAfter)
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.inviteCode == code
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 2. 방 컬렉션 규칙 (rooms/{roomId})
    // -------------------------------------------------------------
    match /rooms/{roomId} {

      // 방 읽기 (get, list): 방 멤버만 허용 (getMyRooms 쿼리 지원)
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // 방 생성 (create): 원자적 신규 생성 + 소유자/멤버/프로필/필드 타입 검증
      allow create: if isSignedIn()
        // 생성 전 부재 검증: rooms/{roomId} 및 inviteCodes/{inviteCode} 문서 모두 미존재
        && !exists(/databases/$(database)/documents/rooms/$(roomId))
        && !exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
        // 필수 및 허용 필드 제한
        && request.resource.data.keys().hasOnly([
          'name', 'region', 'startDate', 'endDate', 'icon',
          'inviteCode', 'ownerId', 'memberIds', 'members',
          'placeCount', 'createdAt', 'updatedAt'
        ])
        // 방 기본 정보 검증
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.region is string && request.resource.data.region.size() > 0
        && request.resource.data.icon in ['sea', 'food', 'nature', 'city', 'healing']
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$')
        // 날짜 검증 (null 허용, 설정 시 timestamp 및 endDate >= startDate)
        && (request.resource.data.startDate == null || request.resource.data.startDate is timestamp)
        && (request.resource.data.endDate == null || (
             request.resource.data.endDate is timestamp &&
             (request.resource.data.startDate == null || request.resource.data.endDate >= request.resource.data.startDate)
           ))
        // 소유자 및 멤버 검증 (생성자 1명만 허용)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys() == [request.auth.uid]
        // members 내 생성자 상세 정보 및 users 프로필 일치 검증 (lastSeenAt은 null만 허용)
        && request.resource.data.members[request.auth.uid].keys().hasOnly(['nickname', 'avatarColor', 'lastSeenAt'])
        && request.resource.data.members[request.auth.uid].nickname is string
        && request.resource.data.members[request.auth.uid].nickname.size() > 0
        && request.resource.data.members[request.auth.uid].nickname == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname
        && request.resource.data.members[request.auth.uid].avatarColor is string
        && request.resource.data.members[request.auth.uid].avatarColor.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.members[request.auth.uid].avatarColor == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.avatarColor
        && request.resource.data.members[request.auth.uid].lastSeenAt == null
        // 초기 placeCount 0 및 생성/수정 시각 검증
        && request.resource.data.placeCount is int && request.resource.data.placeCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // 동일 원자적 요청에서 생성되는 inviteCodes 문서와의 상호 연결 검증 (getAfter)
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.roomId == roomId;

      // 방 삭제 차단
      allow delete: if false;

      // 방 수정 (update): placeCount만 수정 허용 + 정수 및 기존보다 증가 검사 (updatedAt 갱신은 후속 분리)
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members == resource.data.members
        && request.resource.data.name == resource.data.name
        && request.resource.data.region == resource.data.region
        && request.resource.data.icon == resource.data.icon
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == resource.data.updatedAt
        && resource.data.placeCount is int
        && request.resource.data.placeCount is int
        && request.resource.data.placeCount > resource.data.placeCount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['placeCount']);

      // -----------------------------------------------------------
      // 3. 장소 서브컬렉션 규칙 (rooms/{roomId}/places/{placeId})
      // -----------------------------------------------------------
      match /places/{placeId} {

        // 읽기 (get, list): 방 멤버만 허용 (트랜잭션 시 미존재 문서 get 검사 포함)
        allow read: if isRoomMember(roomId);

        // 장소 생성 (create)
        allow create: if isRoomMember(roomId)
          // 문서 ID와 kakaoPlaceId 일치 검사
          && placeId == request.resource.data.kakaoPlaceId
          // 작성자 uid 일치 검사
          && request.resource.data.addedBy == request.auth.uid
          // 필수 필드 및 타입/허용값 검사
          && request.resource.data.kakaoPlaceId is string && request.resource.data.kakaoPlaceId.size() > 0
          && request.resource.data.kakaoPlaceUrl is string && request.resource.data.kakaoPlaceUrl.size() > 0
          && request.resource.data.searchKeyword is string && request.resource.data.searchKeyword.size() > 0
          && request.resource.data.matchType in ['auto', 'confirmed', 'manual']
          && request.resource.data.sourceType in ['screenshot', 'link', 'text']
          && request.resource.data.addedByNickname is string && request.resource.data.addedByNickname.size() > 0
          // 초기값 검사 (빈 좋아요 목록, 정수 0인 좋아요 수, 서버 생성 시각)
          && request.resource.data.likedBy == []
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount == 0
          && request.resource.data.createdAt == request.time
          // 허용 필드 제한 (카카오 장소명/주소/좌표 등 금지 필드 저장 엄격 차단)
          && request.resource.data.keys().hasOnly([
            'kakaoPlaceId', 'kakaoPlaceUrl', 'searchKeyword', 'searchRegion',
            'matchType', 'sourceType', 'sourceUrl', 'addedBy', 'addedByNickname',
            'likedBy', 'likeCount', 'createdAt'
          ])
          // 선택 필드 검사 (생략, null, 또는 문자열 허용)
          && (!('searchRegion' in request.resource.data) || request.resource.data.searchRegion == null || request.resource.data.searchRegion is string)
          && (!('sourceUrl' in request.resource.data) || request.resource.data.sourceUrl == null || request.resource.data.sourceUrl is string)
          // 트랜잭션 동시 실행 검증: 같은 트랜잭션 요청에서 부모 방의 placeCount도 함께 증가했는지 getAfter로 확인
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.placeCount > get(/databases/$(database)/documents/rooms/$(roomId)).data.placeCount;

        // 장소 수정/삭제 차단
        allow update, delete: if false;
      }
    }

    // 기타 모든 경로 접근 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
