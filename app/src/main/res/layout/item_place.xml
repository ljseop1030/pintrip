<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_place"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/place_item_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_icon_container"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/icon_bg_blue"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_category_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_image"
                app:tint="@color/pintrip_blue" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_search_keyword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_bold"
            android:maxLines="1"
            android:textColor="@color/place_title"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tv_added_by"
            app:layout_constraintEnd_toStartOf="@id/layout_like"
            app:layout_constraintStart_toEndOf="@id/cv_icon_container"
            app:layout_constraintTop_toTopOf="@id/cv_icon_container"
            tools:text="해운대 블루라인파크" />

        <TextView
            android:id="@+id/tv_added_by"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard"
            android:maxLines="1"
            android:textColor="@color/place_added_by"
            android:textSize="@dimen/text_caption"
            app:layout_constraintBottom_toBottomOf="@id/cv_icon_container"
            app:layout_constraintEnd_toEndOf="@id/tv_search_keyword"
            app:layout_constraintStart_toStartOf="@id/tv_search_keyword"
            app:layout_constraintTop_toBottomOf="@id/tv_search_keyword"
            tools:text="관광지 · Minji 님이 추가" />

        <LinearLayout
            android:id="@+id/layout_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_source_badge"
            android:backgroundTint="@color/place_likes_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_like_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="@color/place_like_text" />

            <TextView
                android:id="@+id/tv_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/place_like_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
