<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            style="@style/Widget.Pintrip.TextView.Title.Sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/join_code_dialog_title"
            android:textColor="@color/text_dark_navy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pretendard"
            android:text="@string/join_code_dialog_subtext"
            android:textColor="@color/text_link_hint"
            android:textSize="@dimen/text_signup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDialogTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilInviteCode"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="@dimen/input_box_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/input_box_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/input_box_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/input_box_corner_radius"
            app:boxStrokeColor="@color/pintrip_blue"
            app:boxStrokeWidth="2dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDialogSubtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInviteCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center"
                android:hint="@string/join_code_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:letterSpacing="0.2"
                android:maxLength="30"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/text_dark_navy"
                android:textColorHint="#757575"
                android:textSize="18sp"
                android:textStyle="bold" />

        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/pintrip_blue"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilInviteCode"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pbLoading">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/pretendard_bold"
                app:fontFamily="@font/pretendard_bold"
                android:text="@string/btn_cancel"
                android:textColor="@color/button_outlined_text"
                android:textSize="@dimen/text_btn_small"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:strokeColor="@color/button_outlined_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoin"
                style="@style/Widget.Pintrip.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:fontFamily="@font/pretendard_bold"
                app:fontFamily="@font/pretendard_bold"
                android:text="@string/btn_join_action"
                android:textColor="@color/white"
                android:textSize="@dimen/text_btn_small"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
