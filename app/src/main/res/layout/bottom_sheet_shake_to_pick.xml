<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="36dp">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:id="@+id/view_drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_source_badge"
            android:backgroundTint="@color/input_border" />

        <!-- Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/btn_close"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/title_shake_to_pick"
                android:textColor="@color/text_dark_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_circle_light_blue"
                android:contentDescription="@string/btn_close"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_dark_navy" />
        </RelativeLayout>

        <!-- Loading State Layout -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="32dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard"
                android:text="@string/shake_loading_places"
                android:textColor="@color/text_link_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Ready / Awaiting Shake State Layout (Frame 13) -->
        <LinearLayout
            android:id="@+id/layout_ready"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:visibility="visible">

            <!-- Shake Illustration Container -->
            <RelativeLayout
                android:layout_width="200dp"
                android:layout_height="130dp">

                <!-- Background Glow Oval -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="110dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_mascot_oval_glow" />

                <!-- Left Shake Arc -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shake_arcs_left" />

                <!-- Right Shake Arc -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shake_arcs_right" />

                <!-- 3D Mascot Image -->
                <ImageView
                    android:id="@+id/iv_dice_ready"
                    android:layout_width="140dp"
                    android:layout_height="90dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/cd_random_pick"
                    android:rotation="-8"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_mascot_blue" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_ready_heading"
                style="@style/Widget.Pintrip.TextView.Title.Sheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/shake_ready_heading_sensor"
                android:textColor="@color/text_dark_navy" />

            <TextView
                android:id="@+id/tv_ready_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:textColor="@color/pintrip_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="부산 24곳 중에서 하나를 골라 드려요" />

            <TextView
                android:id="@+id/tv_ready_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_source_badge"
                android:backgroundTint="@color/icon_bg_blue"
                android:fontFamily="@font/pretendard_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/pintrip_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="전체" />

            <TextView
                android:id="@+id/tv_ready_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/shake_ready_guide_sensor"
                android:textColor="@color/text_link_hint"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_touch_pick"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/btn_touch_pick"
                android:textColor="@color/button_outlined_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Result State Layout (Frame 14) -->
        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tv_result_headline"
                style="@style/Widget.Pintrip.TextView.Title.Sheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:text="@string/shake_result_headline"
                android:textColor="@color/text_dark_navy" />

            <!-- Result Place Card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_result_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_result_place"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="52dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:id="@+id/tv_result_category_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_source_badge"
                            android:backgroundTint="@color/white"
                            android:fontFamily="@font/pretendard_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/button_outlined_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="관광지" />

                        <TextView
                            android:id="@+id/tv_result_place_name"
                            style="@style/Widget.Pintrip.TextView.Title.Sheet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="@color/text_dark_navy"
                            tools:text="해운대 블루라인파크" />

                        <TextView
                            android:id="@+id/tv_result_place_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/pretendard"
                            android:gravity="center"
                            android:textColor="@color/text_link_hint"
                            android:textSize="12sp"
                            tools:text="관광지 · 부산 해운대구 · Minji 님이 추가" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Overlapping Mascot Image -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="70dp"
                    android:layout_centerHorizontal="true"
                    android:contentDescription="@null"
                    android:src="@drawable/img_mascot_blue" />
            </RelativeLayout>

            <!-- Horizontal Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_again"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="@string/btn_pick_again"
                    android:textColor="@color/button_outlined_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="27dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/button_outlined_text"
                    app:strokeColor="@color/input_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_on_map"
                    style="@style/Widget.Pintrip.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/btn_view_on_map"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_room_map"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty / Error State Layout -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nanum_square_round_eb"
                android:gravity="center"
                android:textColor="@color/text_dark_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="아직 저장한 장소가 없어요." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_empty_close"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/btn_close"
                android:textColor="@color/button_outlined_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
