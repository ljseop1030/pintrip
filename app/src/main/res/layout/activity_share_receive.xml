<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    tools:context=".extract.ShareReceiveActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnCheckPlaces"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Header Subtitle -->
            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/share_receive_header"
                android:textColor="@color/tagline_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Header Main Title -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/Widget.Pintrip.TextView.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/share_receive_title_in_progress"
                android:textColor="@color/text_dark_navy"
                android:textSize="@dimen/text_title"
                tools:text="장소 찾는 중…" />

            <!-- Mascot Illustration -->
            <ImageView
                android:id="@+id/ivMascot"
                android:layout_width="150dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/img_mascot_blue" />

            <!-- Shared Item Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_container_rounded">

                        <ImageView
                            android:id="@+id/ivItemIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_image"
                            app:tint="@color/pintrip_blue" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvItemTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:textColor="@color/text_dark_navy"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            tools:text="스크린샷 1장" />

                        <TextView
                            android:id="@+id/tvItemSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_link_hint"
                            android:textSize="12.5sp"
                            tools:text="갤러리에서 공유됨" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Steps Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp">

                    <!-- Step 1: Image / Content receive -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp">

                            <ImageView
                                android:id="@+id/ivStep1Status"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle" />

                            <ProgressBar
                                android:id="@+id/pbStep1Loading"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminateTint="@color/pintrip_blue"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvStep1Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/pretendard_bold"
                            android:textColor="@color/text_dark_navy"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            tools:text="@string/share_receive_step1_image_completed" />
                    </LinearLayout>

                    <!-- Step 2: OCR Extraction -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp">

                            <ImageView
                                android:id="@+id/ivStep2Status"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_pending_circle"
                                android:visibility="gone" />

                            <ProgressBar
                                android:id="@+id/pbStep2Loading"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminateTint="@color/pintrip_blue"
                                android:visibility="visible" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvStep2Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/pretendard_bold"
                            android:textColor="@color/button_outlined_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            tools:text="@string/share_receive_step2_in_progress" />
                    </LinearLayout>

                    <!-- Step 3: Location Matching -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp">

                            <ImageView
                                android:id="@+id/ivStep3Status"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_pending_circle"
                                android:visibility="visible" />

                            <ProgressBar
                                android:id="@+id/pbStep3Loading"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminateTint="@color/pintrip_blue"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvStep3Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_link_hint"
                            android:textSize="14.5sp"
                            tools:text="@string/share_receive_step3_pending" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inline Extract Failure Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExtractFailure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvFailureMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark_navy"
                        android:textSize="14sp"
                        tools:text="장소를 찾을 수 없습니다." />

                    <LinearLayout
                        android:id="@+id/layoutFailureButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Select Other Photos Button (for NoPlaces) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectOtherPhotos"
                            style="@style/Widget.Pintrip.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="8dp"
                            android:text="@string/share_receive_btn_select_other_photos"
                            android:textSize="13sp" />

                        <!-- Direct Search Button (for NoPlaces) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFailureManualSearch"
                            style="@style/Widget.Pintrip.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="8dp"
                            android:text="@string/btn_manual_search"
                            android:textSize="13sp" />

                        <!-- Retry Button (for Error) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetryExtraction"
                            style="@style/Widget.Pintrip.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="@string/share_receive_btn_retry"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Travel Room Selection Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="@string/share_receive_room_label"
                android:textColor="@color/start_signup_prefix_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRoomSelect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tvRoomName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/text_dark_navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="부산" />

                    <ImageView
                        android:id="@+id/ivRoomSelectArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_sub_gray" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckPlaces"
        style="@style/Widget.Pintrip.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/share_receive_button_check_places"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
