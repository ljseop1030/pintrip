<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tvManualSearchTitle"
        style="@style/Widget.Pintrip.TextView.Title.Sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manual_search_title"
        android:textColor="@color/text_dark_navy"
        android:textSize="@dimen/text_title_sheet" />

    <!-- Room Region Notice -->
    <TextView
        android:id="@+id/tvRoomRegionNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/pretendard"
        android:textColor="@color/text_link_hint"
        android:textSize="@dimen/text_greeting"
        tools:text="방 지역(부산) 안에서 검색합니다" />

    <!-- Search Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchQuery"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/pintrip_surface"
        app:boxCornerRadiusBottomEnd="26dp"
        app:boxCornerRadiusBottomStart="26dp"
        app:boxCornerRadiusTopEnd="26dp"
        app:boxCornerRadiusTopStart="26dp"
        app:boxStrokeColor="@color/pintrip_blue"
        app:boxStrokeWidth="2dp"
        app:endIconMode="clear_text"
        app:endIconTint="@color/text_sub_gray"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/pintrip_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard"
            android:hint="@string/manual_search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_dark_navy"
            android:textColorHint="@color/text_sub_gray"
            android:textSize="@dimen/text_body" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/pbSearchLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/pintrip_blue"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/pretendard"
        android:text="@string/manual_search_empty_result"
        android:textColor="@color/text_link_hint"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Search Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:maxHeight="320dp"
        tools:listitem="@layout/item_confirm_candidate" />

</LinearLayout>
