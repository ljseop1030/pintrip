<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoomItem"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 1. 메인 아이콘 표시 영역 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardBackgroundColor="@color/icon_bg_blue"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivRoomIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_room_category_sea" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 우측 방 제목 및 일정 정보 -->
        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardIconContainer"
            app:layout_constraintTop_toTopOf="@id/cardIconContainer"
            tools:text="부산" />

        <TextView
            android:id="@+id/tvRoomDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/pretendard"
            android:textColor="@color/text_sub_gray"
            android:textSize="@dimen/text_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardIconContainer"
            app:layout_constraintTop_toBottomOf="@id/tvRoomName"
            tools:text="10.24 – 10.26" />

        <!-- 3. 장소 개수 뱃지 -->
        <TextView
            android:id="@+id/tvLocationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_location_badge"
            android:fontFamily="@font/pretendard_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/pintrip_blue"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardIconContainer"
            app:layout_constraintTop_toBottomOf="@id/tvRoomDate"
            tools:text="장소 24" />

        <!-- 4. 아바타 뱃지 -->
        <TextView
            android:id="@+id/tvMemberAvatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_avatar"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvLocationBadge"
            app:layout_constraintStart_toEndOf="@id/tvLocationBadge"
            app:layout_constraintTop_toTopOf="@id/tvLocationBadge"
            tools:text="M" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
