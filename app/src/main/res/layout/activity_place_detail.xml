<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pintrip_surface">

    <!-- 지도 영역 컨테이너 -->
    <FrameLayout
        android:id="@+id/layout_map_container"
        android:layout_width="0dp"
        android:layout_height="250dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.kakao.vectormap.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_map_unavailable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/room_map_not_supported_on_device"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 상단 플로팅 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_circle_white"
        android:contentDescription="@string/btn_close"
        android:elevation="4dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_dark_navy" />

    <!-- 상단 더보기 메뉴 (⋮) (뷰 바인딩 유지용, UI v2 미표시) -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상세 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_map_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="16dp">

            <!-- Card 1: 장소 기본 정보 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_place_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/tv_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_source_badge"
                        android:backgroundTint="@color/icon_bg_blue"
                        android:fontFamily="@font/pretendard_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/category_sights"
                        android:textColor="@color/pintrip_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_place_name"
                        style="@style/Widget.Pintrip.TextView.Title.Sheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_dark_navy"
                        tools:text="해운대 블루라인파크" />

                    <TextView
                        android:id="@+id/tv_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/pretendard"
                        android:textColor="@color/text_link_hint"
                        android:textSize="13sp"
                        tools:text="부산 해운대구 달맞이길62번길 13" />

                    <LinearLayout
                        android:id="@+id/layout_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/text_dark_navy" />

                        <TextView
                            android:id="@+id/tv_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_dark_navy"
                            android:textSize="13sp"
                            tools:text="051-701-5548" />
                    </LinearLayout>

                    <!-- 카카오맵에서 자세히 보기 -->
                    <LinearLayout
                        android:id="@+id/layout_kakao_map_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_open_kakao_map_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="@string/place_detail_open_kakao_map_detail"
                            android:textColor="@color/pintrip_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/pintrip_blue" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: 좋아요 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_likes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/iv_like_heart"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignTop="@id/tv_likes_count"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="@color/place_heart_tint" />

                    <TextView
                        android:id="@+id/tv_likes_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_toEndOf="@id/iv_like_heart"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/text_dark_navy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="좋아요 4" />

                    <TextView
                        android:id="@+id/tv_liked_nicknames"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_likes_count"
                        android:layout_alignStart="@id/tv_likes_count"
                        android:layout_marginTop="2dp"
                        android:layout_toStartOf="@id/layout_avatars"
                        android:fontFamily="@font/pretendard"
                        android:textColor="@color/text_link_hint"
                        android:textSize="12sp"
                        tools:text="Minji, Junho, Seoyeon, Narae" />

                    <LinearLayout
                        android:id="@+id/layout_avatars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_avatar_1"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_avatar_border"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="M" />

                        <TextView
                            android:id="@+id/tv_avatar_2"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="-6dp"
                            android:background="@drawable/bg_circle_avatar_border"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="J" />

                        <TextView
                            android:id="@+id/tv_avatar_3"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="-6dp"
                            android:background="@drawable/bg_circle_avatar_border"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="S" />

                        <TextView
                            android:id="@+id/tv_avatar_4"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="-6dp"
                            android:background="@drawable/bg_circle_avatar_border"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="N" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: 출처 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/tv_source_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="@string/place_detail_source_title"
                        android:textColor="@color/text_link_hint"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layout_source_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_source_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_source_badge"
                            android:backgroundTint="#DDF3EA"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:paddingHorizontal="9dp"
                            android:textColor="#1E7A5C"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="블로그" />

                        <TextView
                            android:id="@+id/tv_source_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_dark_navy"
                            android:textSize="13sp"
                            tools:text="블로그 글" />

                        <TextView
                            android:id="@+id/tv_source_open"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_semibold"
                            android:text="@string/place_detail_source_open"
                            android:textColor="@color/pintrip_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: 추가한 사람 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_added_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/tv_added_by_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="@string/place_detail_added_by_title"
                        android:textColor="@color/text_link_hint"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_added_by_avatar"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="M" />

                        <TextView
                            android:id="@+id/tv_added_by_nickname"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_dark_navy"
                            android:textSize="13sp"
                            tools:text="Minji" />

                        <TextView
                            android:id="@+id/tv_created_at"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard"
                            android:textColor="@color/text_link_hint"
                            android:textSize="12sp"
                            tools:text="10/05" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: 카카오맵 검색 불가 안내 (notFound 일 때 표시) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_not_found_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/badge_exception_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_not_found_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/place_detail_not_found_notice"
                    android:textColor="@color/badge_exception_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 로딩 상태 indicator -->
            <ProgressBar
                android:id="@+id/pb_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />

            <!-- 에러 안내 영역 -->
            <LinearLayout
                android:id="@+id/layout_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_link_hint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    style="@style/Widget.Pintrip.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_retry" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정 바 -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar_top_rounded"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/bottom_bar_padding_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_like"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="64dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/place_detail_like"
            android:enabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_heart_outline"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/place_heart_unliked_tint"
            app:strokeColor="@color/input_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_directions"
            style="@style/Widget.Pintrip.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:text="@string/place_detail_find_directions" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
