<?xml version="1.0" encoding="utf-8"?>
<!--
  18 위치 선택 / 19 직접 검색 후보 라디오 버튼.
  Material 기본 버튼 드로어블은 32dp 고정이라 22dp 뷰에 넣으면 잘리므로 시안 치수로 직접 그린다.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 선택: 두꺼운 링 (바깥 22dp, 안쪽 구멍 8dp) -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/transparent" />
            <stroke
                android:width="@dimen/radio_candidate_stroke_checked"
                android:color="@color/pintrip_blue" />
            <size
                android:width="@dimen/radio_candidate_size"
                android:height="@dimen/radio_candidate_size" />
        </shape>
    </item>

    <!-- 미선택: 얇은 테두리 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/transparent" />
            <stroke
                android:width="@dimen/radio_candidate_stroke"
                android:color="@color/button_outlined_stroke" />
            <size
                android:width="@dimen/radio_candidate_size"
                android:height="@dimen/radio_candidate_size" />
        </shape>
    </item>

</selector>
