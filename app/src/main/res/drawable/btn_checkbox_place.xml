<?xml version="1.0" encoding="utf-8"?>
<!--
  17 장소 선택 체크박스.
  Material 기본 버튼 드로어블은 32dp 고정이라 24dp 뷰에 넣으면 잘리므로 시안 치수로 직접 그린다.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 선택: Primary 채움 + 흰 체크 -->
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/pintrip_blue" />
                    <corners android:radius="@dimen/checkbox_place_corner_radius" />
                    <size
                        android:width="@dimen/checkbox_place_size"
                        android:height="@dimen/checkbox_place_size" />
                </shape>
            </item>
            <item
                android:width="@dimen/checkbox_place_check_size"
                android:height="@dimen/checkbox_place_check_size"
                android:drawable="@drawable/ic_check"
                android:gravity="center" />
        </layer-list>
    </item>

    <!-- 미선택: 얇은 테두리 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <stroke
                android:width="@dimen/checkbox_place_stroke"
                android:color="@color/button_outlined_stroke" />
            <corners android:radius="@dimen/checkbox_place_corner_radius" />
            <size
                android:width="@dimen/checkbox_place_size"
                android:height="@dimen/checkbox_place_size" />
        </shape>
    </item>

</selector>
